{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlideStage Lite",
  "version": "0.2.0",
  "identifier": "dev.slidestage.slidestagelite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlideStage Lite",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Local .stage presentation runtime",
    "longDescription": "SlideStage Lite — open, present, and convert .stage decks. Zero backend, zero accounts, zero upload.",
    "copyright": "© 2026 SlideStage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["stage"],
        "name": "SlideStage Deck",
        "description": "SlideStage presentation package",
        "role": "Viewer",
        "mimeType": "application/x-stage"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["stage"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/SlideStage/SlideStageLite/releases/latest/download/latest.json",
        "https://updates.slidestage.dev/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMzZBNzNEMEQ1MEJEMjMKUldRanZWQU5QYWMycTZkcCtzQXpDWVBTa2FnMUpsQkRBUUpaa2xTUG16ZEhWdzJTdVU4czR5bmkK"
    }
  }
}
