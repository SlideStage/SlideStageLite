{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlidesDeckLite",
  "version": "0.1.0",
  "identifier": "com.hcliu.slidesdecklite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlidesDeckLite",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local .hcslides presentation runtime",
    "longDescription": "SlidesDeckLite — open, present, and convert .hcslides decks. Zero backend, zero accounts, zero upload.",
    "copyright": "© 2026 hcliu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["hcslides"],
        "name": "HCSlides Deck",
        "description": "SlidesDeck presentation package",
        "role": "Viewer",
        "mimeType": "application/x-hcslides"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hcslides"]
      }
    }
  }
}
