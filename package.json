{
  "name": "slidestage-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure frontend .stage presentation runtime",
  "scripts": {
    "predev": "pnpm fixtures",
    "dev": "vite",
    "prebuild": "pnpm fixtures",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fixtures": "node scripts/build-fixtures.mjs",
    "convert": "tsx bin/convert.ts",
    "mirror": "tsx bin/mirror.ts",
    "test": "pnpm fixtures && pnpm typecheck && pnpm test:unit && pnpm test:e2e",
    "pretest:unit": "pnpm fixtures",
    "test:unit": "vitest run",
    "pretest:e2e": "pnpm fixtures",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "pnpm typecheck && pnpm build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:smoke": "node scripts/desktop-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
