{
  "name": "slidestage-lite",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Pure frontend .stage presentation runtime",
  "scripts": {
    "sync:brand": "node scripts/sync-brand.mjs",
    "predev": "pnpm fixtures && pnpm sync:brand",
    "dev": "vite",
    "prebuild": "pnpm fixtures && pnpm sync:brand",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fixtures": "node scripts/build-fixtures.mjs",
    "convert": "tsx bin/convert.ts",
    "mirror": "tsx bin/mirror.ts",
    "test": "pnpm fixtures && pnpm typecheck && pnpm test:unit && pnpm test:e2e",
    "pretest:unit": "pnpm fixtures",
    "test:unit": "vitest run",
    "pretest:e2e": "pnpm fixtures",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "pnpm check:boundaries && pnpm check:ecosystem-readme && pnpm typecheck && pnpm build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "render:ecosystem": "node packages/brand/tools/render-ecosystem.mjs --target=README.md --lang=en && node packages/brand/tools/render-ecosystem.mjs --target=README_cn.md --lang=zh",
    "check:ecosystem-readme": "node packages/brand/tools/render-ecosystem.mjs --target=README.md --lang=en --check && node packages/brand/tools/render-ecosystem.mjs --target=README_cn.md --lang=zh --check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:smoke": "node scripts/desktop-smoke.mjs",
    "release:macos": "node scripts/release-macos.mjs",
    "release:windows": "node scripts/release-windows.mjs",
    "check:macos-signing": "node scripts/check-macos-signing.mjs",
    "updater:keygen": "node scripts/generate-updater-key.mjs",
    "updater:manifest": "node scripts/build-update-manifest.mjs",
    "preview:cloudflare": "pnpm build && pnpm dlx wrangler dev",
    "deploy:cloudflare": "pnpm build && pnpm dlx wrangler deploy",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "@slidestage/brand": "workspace:*",
    "@slidestage/core": "workspace:*",
    "@slidestage/lite-preset": "workspace:*",
    "@slidestage/ui": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.60.0",
    "@slidestage/spec": "workspace:*",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.6",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
