# SlideStageLite repo ignore list
#
# We keep only "shippable" source under version control: src/, bin/,
# scripts/, config files, index.html, package manifests. AI-generated
# process artefacts (docs/, design-system/, generated tests/) live on
# disk for local reference but are deliberately kept out of git.

# Dependencies & build artefacts
node_modules/
.pnpm-store/
dist/
# Negation: `dist/` above is intentionally a wildcard so it catches the
# root vite build output, every `packages/*/dist/` tsup output, and any
# future `apps/*/dist/`. But `@slidestage/spec` ships *fixture sample
# decks* under `packages/spec/fixtures/sources/*/` and reveal-basic
# happens to use the official reveal.js layout `dist/reveal.js`. Without
# this re-include the wildcard above would drop `reveal.js` from the
# committed tree (and therefore from `npm pack` — `files:["dist","fixtures",...]`
# in `packages/spec/package.json` honours .gitignore). Other frameworks
# (impress-basic, html-ppt, etc.) ship their JS flat next to index.html,
# so this carve-out is reveal-shaped and intentionally narrow.
!packages/spec/fixtures/sources/*/dist/
!packages/spec/fixtures/sources/*/dist/**

# Cloudflare wrangler local state (preview cache, miniflare scratch).
# Real Workers deploys never read from here; safe to recreate from scratch.
.wrangler/

# Generated sample fixtures (regenerated by `pnpm fixtures`, also auto-built via predev/prebuild hooks)
public/fixtures/

# Brand assets mirrored from @slidestage/brand (regenerated by `pnpm sync:brand`,
# auto-invoked via predev/prebuild). The npm package is the source of truth.
public/brand/

# Test runners' scratch output
test-results/
playwright-report/

# OS / editor noise
.DS_Store
*.log

# Local env files — only .env.example is tracked. Keep beian numbers,
# deploy secrets, etc. out of git.
.env
.env.*
!.env.example

# AI-generated process artefacts — kept on disk unless explicitly allowlisted.
# Note: tests/e2e/ holds the hand-authored Playwright suite (real CI source) and
# stays tracked; only tests/fixtures/ (generated by `pnpm fixtures`) is scratch.
docs/
tests/fixtures/
design-system/
.cursor/
.memory/

dist-desktop/
