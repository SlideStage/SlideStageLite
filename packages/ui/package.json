    "./i18n/translator": "./src/i18n/translator.tsx",
    "./viewer/AudienceView": "./src/viewer/AudienceView.tsx",
    "./viewer/DeckStage": "./src/viewer/DeckStage.tsx",
    "./viewer/DeckViewer": "./src/viewer/DeckViewer.tsx",
    "./viewer/DeckViewerHeader": "./src/viewer/DeckViewerHeader.tsx",
    "./viewer/NotesPanel": "./src/viewer/NotesPanel.tsx",
    "./viewer/Overview": "./src/viewer/Overview.tsx",
    "./viewer/PresenterSideRail": "./src/viewer/PresenterSideRail.tsx",
    "./viewer/PresenterStageBlock": "./src/viewer/PresenterStageBlock.tsx",
    "./viewer/SpeakerNotesPanel": "./src/viewer/SpeakerNotesPanel.tsx",
    "./viewer/SpeakerPanel": "./src/viewer/SpeakerPanel.tsx",
    "./viewer/useAudiencePointerTracking": "./src/viewer/useAudiencePointerTracking.ts",
    "./viewer/useDeckViewerResize": "./src/viewer/useDeckViewerResize.ts",
