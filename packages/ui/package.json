    "./presenter/Blackout": "./src/presenter/Blackout.tsx",
    "./presenter/LaserPointer": "./src/presenter/LaserPointer.tsx",
    "./presenter/Spotlight": "./src/presenter/Spotlight.tsx",
    "./presenter/usePresentationSync": "./src/presenter/usePresentationSync.ts",
    "./presenter/transport": "./src/presenter/transport/index.ts",
    "./presenter/transport/broadcastChannel": "./src/presenter/transport/broadcastChannel.ts",
