# SlideStage Lite — environment variables.
#
# Copy this file to `.env` (or `.env.local`) and fill in the values that apply
# to your deployment. All variables here are baked into the static bundle at
# build time, so changes only take effect after rebuilding (`pnpm build`).
#
# Every variable below is OPTIONAL. When left empty, the corresponding piece
# of UI is simply not rendered — the landing page falls back to the plain
# "local · no server" status line with no Chinese beian (ICP / 公安备案) chip.
#
# ⚠️  IMPORTANT — quote any URL that contains a `#`
# Vite reads this file via dotenv, which treats `#` as the start of an inline
# comment. An unquoted `https://beian.mps.gov.cn/#/query/...` therefore
# silently truncates to `https://beian.mps.gov.cn/` and your audit link will
# 404. Wrap any value containing `#`, spaces, or `$` in DOUBLE QUOTES.
#   ✘  VITE_BEIAN_MPS_URL=https://example.com/#/foo?bar=1   ← truncated
#   ✓  VITE_BEIAN_MPS_URL="https://example.com/#/foo?bar=1"  ← preserved

# ── 中国大陆 ICP 备案（工信部） ────────────────────────────────────────────────
# Mainland-China ICP filing number, shown as a clickable link in the landing
# page footer. Leave both empty if your deployment does not need an ICP chip
# (overseas hosting, internal-only, etc.).
#
# Example values (replace with your own — these belong to cursor-loss, do NOT
# reuse them on a deployment that is not part of that filing!):
#   VITE_BEIAN_ICP_TEXT="京ICP备2026000000号-1"
#   VITE_BEIAN_ICP_URL="https://beian.miit.gov.cn/"
VITE_BEIAN_ICP_TEXT=
VITE_BEIAN_ICP_URL="https://beian.miit.gov.cn/"

# ── 中国大陆 公安备案 ─────────────────────────────────────────────────────────
# Public Security ("公网安备") filing number. When TEXT is set the footer also
# renders the small 国徽 logo (`/mpslogo.png`) next to the link.
#
# The URL must be the full beian.mps.gov.cn query URL for your record (the
# `code=` query string is the numeric part of your filing number). The URL
# below contains a `#`, so it MUST be wrapped in double quotes — see the
# warning at the top of this file.
#
#   VITE_BEIAN_MPS_TEXT="京公网安备11010100000001号"
#   VITE_BEIAN_MPS_URL="https://beian.mps.gov.cn/#/query/webSearch?code=11010100000001"
VITE_BEIAN_MPS_TEXT=
VITE_BEIAN_MPS_URL=

# ── macOS Code Signing & Notarization (desktop release only) ─────────────────
# These variables are consumed by `pnpm release:macos` (scripts/release-macos.mjs)
# and forwarded to Tauri's bundler. They are NOT baked into the Vite bundle —
# the Vite build doesn't even see them — so they don't end up in the public
# `dist/` output.
#
# Keep the *actual* values in `.env.local` (gitignored). This file only documents
# the variable names.
#
# How to provision (one-time):
#   1. Join the Apple Developer Program ($99/yr).
#   2. Generate a "Developer ID Application" certificate in Apple Developer
#      portal → Certificates, IDs & Profiles → Create. Download the .cer,
#      double-click to install into Keychain Access. Verify with:
#        security find-identity -v -p codesigning
#      The full name (e.g. "Developer ID Application: Foo Bar (TEAMID)") becomes
#      APPLE_SIGNING_IDENTITY below.
#   3. Generate an App Store Connect API key at
#        https://appstoreconnect.apple.com/access/integrations/api
#      with the "Developer" role (sufficient for notarization). Download the .p8
#      file ONCE (you cannot re-download), store it at a stable path such as
#        ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8
#      and note the Key ID + Issuer ID.
#
# See docs/MACOS_NOTARIZATION.md for the full walkthrough.

# Full name of the signing identity, as printed by
#   security find-identity -v -p codesigning
# Use the value verbatim, including the parenthesised Team ID.
#   APPLE_SIGNING_IDENTITY="Developer ID Application: Foo Bar (ABCDE12345)"
APPLE_SIGNING_IDENTITY=

# App Store Connect API key — preferred over Apple-ID + app-specific password
# because it can be revoked per-integration and works in CI without UI prompts.
# Key ID is the 10-char string visible in the ASC integrations table.
#   APPLE_API_KEY=ABCDE12345
APPLE_API_KEY=

# Issuer ID is the UUID printed above the keys table on the ASC integrations page.
#   APPLE_API_ISSUER=12345678-1234-1234-1234-1234567890ab
APPLE_API_ISSUER=

# Absolute path to the downloaded .p8 file. We recommend
# ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8 because that is also where
# `xcrun notarytool` looks by default, so manual sanity-checks just work.
#   APPLE_API_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_ABCDE12345.p8
APPLE_API_KEY_PATH=

# Optional: only required when your APPLE_SIGNING_IDENTITY string is ambiguous
# (multiple Developer ID certs from different teams in the same keychain). The
# Team ID is the 10-char string in parentheses at the end of the identity name.
#   APPLE_TEAM_ID=ABCDE12345
APPLE_TEAM_ID=
